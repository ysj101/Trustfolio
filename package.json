{
  "name": "trustfolio-gas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:css": "bash scripts/build-styles.sh",
    "build:js": "rollup -c",
    "build:html": "cp src/ui/Index.html dist/ && cp src/ui/Performance.html dist/ && cp src/ui/scripts.html dist/ && cp src/ui/performance-scripts.html dist/ && cp src/ui/styles.html dist/",
    "build": "pnpm build:js && pnpm build:html && pnpm build:css",
    "push": "pnpm lint && pnpm build && clasp push --force",
    "setup:clasp": "scripts/setup-clasp.sh",
    "sync:env": "node scripts/sync-env-to-gas.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest",
    "test:rakuten": "node scripts/rakuten-integration-test.mjs",
    "test:nav-fetch": "node scripts/nav-fetch-test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@google/clasp": "^3.2.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/google-apps-script": "^1.0.83",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-prettier": "^5.5.5",
    "hono": "^4.11.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rollup": "^4.57.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "pnpm vitest related --run"
    ]
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1"
    }
  }
}
