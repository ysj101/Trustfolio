{
  "name": "trustfolio-gas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:css": "bash scripts/build-styles.sh",
    "build:js": "vite build",
    "build": "pnpm build:js && pnpm build:css",
    "push": "pnpm lint && pnpm build && clasp push --force",
    "setup:clasp": "scripts/setup-clasp.sh",
    "sync:env": "node scripts/sync-env-to-gas.mjs",
    "lint": "pnpm lint:oxlint && pnpm lint:architecture && pnpm typecheck && pnpm lint:typescript-rules",
    "lint:fix": "pnpm lint:oxlint:fix && pnpm format && pnpm lint:architecture && pnpm typecheck && pnpm lint:typescript-rules",
    "lint:oxlint": "oxlint src scripts vitest.config.ts vite.config.ts --import-plugin --promise-plugin --deny-warnings",
    "lint:oxlint:fix": "oxlint src scripts vitest.config.ts vite.config.ts --import-plugin --promise-plugin --deny-warnings --fix",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "lint:typescript-rules": "node scripts/check-typescript-rules.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "format": "oxfmt src tests scripts vite.config.ts vitest.config.ts package.json .oxfmtrc.json",
    "format:check": "oxfmt --check src tests scripts vite.config.ts vitest.config.ts package.json .oxfmtrc.json",
    "test": "vitest",
    "test:rakuten": "node scripts/rakuten-integration-test.mjs",
    "test:nav-fetch": "node scripts/nav-fetch-test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/google-apps-script": "^2.0.11",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-js-api": "npm:typescript@^6.0.3",
    "vite": "8.1.5",
    "vite-plus": "0.2.6",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,css,html}": [
      "oxfmt"
    ],
    "src/**/*.ts": [
      "oxlint --import-plugin --promise-plugin --deny-warnings --fix",
      "pnpm vitest related --run"
    ],
    "scripts/**/*.mjs": [
      "oxlint --import-plugin --promise-plugin --deny-warnings --fix"
    ],
    "{vitest.config.ts,vite.config.ts}": [
      "oxlint --import-plugin --promise-plugin --deny-warnings --fix"
    ]
  },
  "engines": {
    "node": ">=22.22.1 <23 || >=24.11.0 <25",
    "pnpm": ">=10.30.2 <11"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4",
  "pnpm": {
    "overrides": {
      "vite": "8.1.5",
      "qs": ">=6.15.2",
      "minimatch": ">=10.2.3",
      "express-rate-limit": ">=8.2.2",
      "@hono/node-server": ">=2.0.5 <3",
      "hono": ">=4.12.27 <5",
      "body-parser": ">=2.3.0 <3",
      "yaml": "2.8.3",
      "path-to-regexp": "8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "ip-address": "10.3.1",
      "fast-uri": ">=3.1.5 <4",
      "uuid@<14.0.0": ">=14.0.0",
      "esbuild@<0.28.1": ">=0.28.1",
      "postcss@<8.5.23": ">=8.5.23"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@formatjs/intl@3.1.8>typescript": "^6.0.0 || ^7.0.0"
      }
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-12590",
        "CVE-2026-59897",
        "CVE-2026-59896",
        "CVE-2026-59895",
        "CVE-2026-13676"
      ],
      "ignoreGhsas": [
        "GHSA-frvp-7c67-39w9",
        "GHSA-8j4g-w8fx-2239"
      ]
    }
  }
}
