{
  "name": "trustfolio-gas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "rollup -c",
    "push": "pnpm lint && pnpm build && clasp push --force",
    "setup:clasp": "scripts/setup-clasp.sh",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:rakuten": "node scripts/rakuten-integration-test.mjs",
    "test:nav-fetch": "node scripts/nav-fetch-test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@google/clasp": "^2.4.2",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/google-apps-script": "^1.0.83",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rollup": "^4.21.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.50.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.26.2"
}
