{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm lint --quiet 2>&1 || (echo 'Lintエラーがあります。修正してください。' >&2; exit 2)",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
